# Local secrets for `supabase functions serve` (copy to supabase/functions/.env, never commit).
# In the cloud set them with `supabase secrets set` (see docs/setup-backend.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
AI_DAILY_LIMIT=200
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: GEMINI_THINKING_LEVEL=low
# Pronunciation audio (tts function): models, optional voices, daily generations per user.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
TTS_DAILY_LIMIT=150
# Optional: GEMINI_TTS_VOICE_US=Iapetus  GEMINI_TTS_VOICE_GB=Erinome
# Article import (fetch-article, decision 0044): articles per user and UTC day.
ARTICLE_DAILY_LIMIT=30
# Claude is the primary model of the text AI tasks, Gemini the fallback (decision 0077). Needs
# ANTHROPIC_API_KEY and the text budget in the database; AI_CLAUDE_FALLBACK=off: Gemini only;
# AI_TEXT_PRIMARY=gemini: Gemini first. Model: CLAUDE_TEXT_MODEL (default in model-defaults.ts).
# Shares: AI_USER_MONTHLY_USD=2 AI_USER_MAX_SHARE=0.2 AI_OWNER_MAX_SHARE=0.75 APP_ADMIN_USER_ID=
# ANTHROPIC_API_KEY=
# CLAUDE_TEXT_MONTHLY_USD=10
# Optional: pronunciation audio on Cloudflare R2 (decision 0053). All five, or none (Supabase
# Storage only). AUDIO_BASE_URL is the bucket's public https address.
# R2_ACCOUNT_ID=  R2_ACCESS_KEY_ID=  R2_SECRET_ACCESS_KEY=  R2_BUCKET=engapp-audio
# AUDIO_BASE_URL=https://pub-<id>.r2.dev
